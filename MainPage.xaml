<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReadingTracker.MainPage">
    <Grid
    RowDefinitions="*,auto">
        <ScrollView
            Grid.Row="0">
            <VerticalStackLayout
                Padding="30,0"
                Spacing="25">
                <Grid
                    RowDefinitions="Auto"
                    ColumnDefinitions="20*,*">
                    <Label
                    Padding="10"
                    Text="User Library"
                    FontSize="50"
                    FontFamily="AgravePro"
                    HorizontalOptions="Center"
                    Grid.Column="0"/>
                    <Button
                        Padding="10"
                        ImageSource="settings.png"
                        HeightRequest="5"
                        FontFamily="AgravePro"
                        Grid.Column="1"/>
                </Grid>
                <Grid
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                    ColumnDefinitions="*,4*,4*,4*"
                    BackgroundColor="LightGray">
                    <Image
                        Margin="10"
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Aspect="AspectFit"
                        Source="dotnet_bot.png"/>
                    <Label
                        Margin="10"
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="Title"
                        FontSize="20"/>
                    <Label
                        Margin="10"
                        Grid.Row="0"
                        Grid.Column="2"
                        Text="Author"
                        FontSize="20"/>
                    <Label
                        Margin="10"
                        Grid.Row="0"
                        Grid.Column="3"
                        Text="Year"
                        FontSize="20"/>
                    <Label
                        Margin="10"
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Text="Stars"
                        FontSize="20"/>
                    <Label
                        Margin="10"
                        Grid.Row="1"
                        Grid.Column="3"
                        Text="Year of Completion"
                        FontSize="20"/>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
        <Grid
            ColumnDefinitions="*,*,*,*"
            Grid.Row="1">
            <Button
            Text="Want to read"
             Grid.Column="0"
             FontSize="20"
                Margin="10"/>
            <Button
             Text="Reviews"
             Grid.Column="1"
             FontSize="20"
                Margin="10"/>
            <Button
             Text="Search"
             Grid.Column="2"
             FontSize="20"
                Margin="10"/>
            <Button
             Text="Profile"
             Grid.Column="4"
             FontSize="20"
                Margin="10"/>
        </Grid>
    </Grid>
</ContentPage>
